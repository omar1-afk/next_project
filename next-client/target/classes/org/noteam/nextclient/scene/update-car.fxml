<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="482.0" prefWidth="708.0" styleClass="root-container" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.noteam.nextclient.controller.UpdateCarController">
    <children>
        <Label layoutX="50.0" layoutY="40.0" styleClass="title-label" text="Update Car Details" />

        <VBox layoutX="50.0" layoutY="120.0" spacing="25.0">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label styleClass="field-headline" text="Type" />
                        <TextField fx:id="carTypeField" prefHeight="40.0" prefWidth="124.0" promptText="e.g. Sedan, Truck, Van" styleClass="input-field" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label styleClass="field-headline" text="Weight Limit" />
                        <TextField fx:id="weightLimitField" prefHeight="40.0" prefWidth="400.0" promptText="e.g. 2000kg" styleClass="input-field" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label styleClass="field-headline" text="License Plate" />
                        <TextField fx:id="carPlateField" prefHeight="40.0" prefWidth="624.0" promptText="ABC-1234" styleClass="input-field" />
                    </children>
                </VBox>
            </children>
        </VBox>

          <Button fx:id="updateCarButton" layoutX="254.0" layoutY="379.0" onAction="#handleUpdateCar" prefHeight="45.0" prefWidth="200.0" styleClass="update-button" text="UPDATE CAR" />
    </children>
</AnchorPane>
