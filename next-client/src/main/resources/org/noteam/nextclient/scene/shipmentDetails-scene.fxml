<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.noteam.nextclient.controller.ShipmentDetailsController"
      style="-fx-background-color: white;">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <!-- Header Section -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="shipment-id" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Label fx:id="shipmentIdLabel" text="SHP-123456789" 
               style="-fx-font-size: 16px; -fx-text-fill: #666;"/>
    </HBox>
    
    <!-- Info Fields Row -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <!-- Vehicle -->
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="vehicle" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
            <Label fx:id="vehicleLabel" text="vehicle id" 
                   style="-fx-font-size: 14px; -fx-padding: 8; -fx-background-color: #f5f5f5; -fx-background-radius: 4;"/>
        </VBox>
        
        <!-- Driver -->
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="driver" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
            <Label fx:id="driverLabel" text="driver id" 
                   style="-fx-font-size: 14px; -fx-padding: 8; -fx-background-color: #f5f5f5; -fx-background-radius: 4;"/>
        </VBox>
        
        <!-- Shipping Date -->
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="shipping date" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
            <Label fx:id="shippingDateLabel" text="YYYY/MM/DD" 
                   style="-fx-font-size: 14px; -fx-padding: 8; -fx-background-color: #f5f5f5; -fx-background-radius: 4;"/>
        </VBox>
        
        <!-- Completed Status -->
        <VBox spacing="5">
            <Label text=" " style="-fx-font-size: 12px;"/>
            <Label fx:id="completedLabel" text="completed" 
                   style="-fx-background-color: #e0e0e0; -fx-text-fill: #666; -fx-padding: 8 16; -fx-background-radius: 4;"/>
        </VBox>
    </HBox>
    
    <!-- Orders Table -->
    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Orders" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        
        <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS" 
                   editable="false"
                   style="-fx-background-color: white; -fx-border-color: #e0e0e0;">
            <columns>
               <TableColumn fx:id="idColumn" text="Order details" prefWidth="180"/>
                
                <TableColumn fx:id="weightColumn" text="Weight" prefWidth="120"/>

            <!-- 
                <TableColumn fx:id="dimensionsColumn" text="Dimensions" prefWidth="150">
                    <cellValueFactory>
                        <javafx.scene.control.cell.PropertyValueFactory property="dimensions"/>
                    </cellValueFactory>
                </TableColumn>
                -->
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="180"/>
                
               <TableColumn fx:id="priceColumn" text="Price" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
    
</VBox>
