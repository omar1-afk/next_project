<VBox minHeight="720.0" minWidth="1024.0" spacing="20" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.noteam.nextclient.controller.ShipmentDetailsController"
stylesheets="@style.css"
   >
    
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    
    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Shipment-id" />
        <Label fx:id="shipmentIdLabel" style="-fx-font-size: 16px; -fx-text-fill: #666;" text="SHP-123456789" />
    </HBox>
    
    <!-- Info Fields Row -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <!-- Vehicle -->
        <VBox maxWidth="300.0" minWidth="120.0" prefWidth="0.0" spacing="5" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #666;" text="Vehicle" />
         <Label fx:id="vehicleIdLabel" alignment="CENTER" contentDisplay="CENTER" maxWidth="200.0" minWidth="80.0" prefWidth="80.0" style="-fx-background-color: #eee;" text="vehicle-id">
            <font>
               <Font size="16.0" />
            </font>
            <padding>
               <Insets bottom="8.0" top="8.0" />
            </padding>
         </Label>
        </VBox>
        
        <!-- Driver -->
        <VBox maxWidth="300.0" minWidth="120.0" spacing="5" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #666;" text="Driver" />
         <Label fx:id="driverIdLabel" alignment="CENTER" contentDisplay="CENTER" maxWidth="200.0" minWidth="80.0" prefWidth="80.0" style="-fx-background-color: #eee;" text="driver-id">
            <font>
               <Font size="16.0" />
            </font>
            <padding>
               <Insets bottom="8.0" top="8.0" />
            </padding>
         </Label>
        </VBox>
        
        <!-- Shipping Date -->
        <VBox alignment="CENTER_LEFT" maxWidth="300.0" minWidth="120.0" prefHeight="52.0" prefWidth="102.0" spacing="5" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #666;" text="Shipping date" />
         <DatePicker fx:id="datePicker" editable="true" prefHeight="28.0" prefWidth="240.0">
            <VBox.margin>
               <Insets />
            </VBox.margin>
         </DatePicker>
        </VBox>
        
              <!-- Completed Status -->
        <VBox alignment="BOTTOM_CENTER" spacing="5">
         <CheckBox fx:id="completedCheckbox" mnemonicParsing="false" text="Completed" />
         <HBox.margin>
            <Insets right="36.0" />
         </HBox.margin>
         <padding>
            <Insets bottom="8.0" />
         </padding>
        </VBox>
    </HBox>
    
    <!-- Orders Table -->
