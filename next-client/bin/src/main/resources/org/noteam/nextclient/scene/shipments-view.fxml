<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>

<BorderPane fx:id="shipmentPane" style="-fx-background-color: red;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.noteam.nextclient.controller.ShipmentController">
    <top>
        <Pane prefHeight="20.0" style="-fx-background-color: blue;" BorderPane.alignment="CENTER" />
    </top>
    <left>
        <Pane prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: blue;" BorderPane.alignment="CENTER" />
    </left>
    <center>
      <Pane prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: black;" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="openPopUp" layoutX="70.0" layoutY="87.0" mnemonicParsing="false" onAction="#showPopUp" text="Button" />
         </children></Pane>
    </center>
</BorderPane>
